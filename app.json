{
  "expo": {
    "name": "ARIS Web App",
    "slug": "aris-web-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "aris",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f7f9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aris.webapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f6f7f9",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.aris.webapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
